E 10.0.0.1 0 23 5501 11 2320 12 3181 | ip.addr == 10.0.0.1
E 10.0.0.2 0 23 5501 12 3181 11 2320 | ip.addr == 10.0.0.2
C 10.0.0.1 0 10.0.0.2 0 23 5501 11 2320 12 3181 0.000000 0.022000 1 | ip.addr == 10.0.0.1 && ip.addr == 10.0.0.2
-- IPv6
-- TCP
E 10.0.0.1 50000 23 5501 11 2320 12 3181 | ip.addr == 10.0.0.1 && tcp.port == 50000
E 10.0.0.2 443 23 5501 12 3181 11 2320 | ip.addr == 10.0.0.2 && tcp.port == 443
C 10.0.0.1 50000 10.0.0.2 443 23 5501 11 2320 12 3181 0.000000 0.022000 1 | ip.addr == 10.0.0.1 && ip.addr == 10.0.0.2 && tcp.port == 50000 && tcp.port == 443
-- UDP
-- SCTP
-- Ethernet
-- WLAN
-- Bluetooth
-- USB
-- Hierarchy
Frame 23 5501
  Ethernet 23 5501
    Internet Protocol Version 4 23 5501
      Transmission Control Protocol 23 5501
        Transport Layer Security 16 3523
          Hypertext Transfer Protocol 2 7 658
