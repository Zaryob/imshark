# clang-tidy focuses on real bugs in code that parses untrusted capture files, not on style (that is .clang-format's job).
# CI runs it with -warnings-as-errors=*, so every enabled check must stay at zero findings; see CONTRIBUTING.md
# ("Static analysis") for how to run it and for the NOLINT policy.
#
# Globs keep the set stable across clang-tidy versions; checks that do not exist in the installed version are ignored.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-branch-clone,
  -bugprone-exception-escape,
  -bugprone-reserved-identifier,
  -bugprone-macro-parentheses,
  cert-err34-c,
  cert-str34-c,
  cert-flp30-c,
  cert-env33-c,
  cert-mem57-cpp,
  cert-dcl50-cpp,
  cert-oop54-cpp,
  cert-oop58-cpp,
  cert-msc50-cpp,
  cert-msc51-cpp,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  performance-*,
  -performance-enum-size,
  -performance-avoid-endl,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-include-cleaner,
  -misc-const-correctness,
  -misc-use-anonymous-namespace,
  -misc-use-internal-linkage,
  -misc-unused-parameters,
  -misc-header-include-cycle
# Only diagnostics located in project code are reported; vcpkg, build and third_party headers are skipped.
HeaderFilterRegex: '^(?!.*(vcpkg_installed|[/\\]\.vcpkg|third_party|[/\\]_deps[/\\])).*[/\\](core|src|tests|tools)[/\\].*'
WarningsAsErrors: ''
FormatStyle: none
